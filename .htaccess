# ==========================================================================
# Okur Nakliyat — Apache / cPanel üretim ayarları
# Tüm bloklar <IfModule> ile korumalıdır: ilgili modül sunucuda yoksa
# satırlar yok sayılır, site hata vermez.
# ========================================================================== 

# --------------------------------------------------------------------------
# Varsayılan belge ve özel hata sayfası
# --------------------------------------------------------------------------
DirectoryIndex index.html

# Bu satır şu an sunucuda ETKİSİZ; bilerek duruyor.
#
# Ölçülen durum (bkz. docs/sunucu-teshis.md):
#   - Yayındaki .htaccess bu dosya. X-Okur-Htaccess işareti canlıda görünüyor.
#   - Apache dosyayı okuyor: aynı dosyanın "Header always set" satırları 404
#     yanıtına bile uygulanıyor.
#   - Buna rağmen ErrorDocument hiçbir biçimde sonuç vermiyor. Dosya yolu da
#     denendi, metin biçimi de ("ErrorDocument 404 \"...\""); ikisinde de
#     olmayan bir URL 13 baytlık çıplak "404 Not Found" ve charset=iso-8859-1
#     ile dönüyor. /404.html doğrudan istendiğinde 200 ve doğru içerikle
#     geliyor.
#
# Yani sorun iç alt-istekte değil, direktifin tümden geçersiz kılınmasında --
# sunucu seviyesinde veya bir güvenlik modülünce. .htaccess üzerinden
# uygulanabilecek bir çözüm yok; hosting desteğinin müdahalesi gerekiyor.
#
# Satır kaldırılmıyor: sunucu tarafı düzeldiğinde doğru davranış kendiliğinden
# devreye girsin.
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Karakter kodlaması ve MIME türleri
# --------------------------------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/xml .xml
</IfModule>

# --------------------------------------------------------------------------
# HTTPS + kanonik alan adı yönlendirmesi
# Tercih edilen adres: https://okurnakliyatedremit.com
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Yalnızca dış istekte çalışsın. ErrorDocument iç alt-istekle servis
  # edildiğinde bu kural yeniden değerlendirilirse hata belgesi yönlendirmeye
  # dönüşür ve sunucu özel 404 yerine düz "404 Not Found" döndürür.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.okurnakliyatedremit\.com$ [NC]
  RewriteRule ^ https://okurnakliyatedremit.com%{REQUEST_URI} [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# Sıkıştırma
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Tarayıcı önbelleği
# HTML, XML ve robots anında güncellenir; sürümlü statik dosyalar uzun süre tutulur.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/plain                "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
  ExpiresByType text/xml                  "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|svg|png|jpg|jpeg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Sunucudaki .htaccess'in gerçekten bu dosya olup olmadığını dışarıdan
  # ölçmek için. Bu dosya her değiştiğinde numara artırılmalı; site
  # kontrolü yayındaki değeri buradaki değerle karşılaştırıyor.
  # Gerekçe: 404 yanıtı .htaccess'in Header satırlarını taşıyor ama
  # ErrorDocument satırını uygulamıyor. Bu işaret, "dosya eski" ile
  # "Apache ErrorDocument'ı yok sayıyor" ihtimallerini birbirinden ayırır.
  Header always set X-Okur-Htaccess "3"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --------------------------------------------------------------------------
# Dizin listelemeyi kapat
# --------------------------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
